        },
        {
          "capability": "network:fetch",
          "pattern": "skynet://casa/read/*"
        },
        {
          "capability": "skynet:casa:read",
          "pattern": "skynet://casa/read/*"
        },
        {
          "capability": "tool:invoke",
          "pattern": "skynet://agenda/busy"
        },
        {
